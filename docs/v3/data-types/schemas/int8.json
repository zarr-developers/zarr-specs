{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "int8",
  "description": "Signed 8-bit integer data type.",
  "type": "object",
  "properties": {
    "data_type": {
      "$ref": "#/$defs/identifier"
    },
    "fill_value": {
      "$ref": "#/$defs/element"
    }
  },
  "$defs": {
    "identifier": {
      "description": "The identifier of the int8 data type.",
      "const": "int8"
    },
    "element": {
      "description": "An integer in [-128, 127].",
      "type": "integer",
      "minimum": -128,
      "maximum": 127
    }
  }
}
