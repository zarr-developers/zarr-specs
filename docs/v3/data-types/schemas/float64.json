{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "float64",
  "description": "IEEE 754 64-bit floating point data type.",
  "type": "object",
  "properties": {
    "data_type": {
      "$ref": "#/$defs/identifier"
    },
    "fill_value": {
      "$ref": "#/$defs/element"
    }
  },
  "$defs": {
    "identifier": {
      "description": "The identifier of the float64 data type.",
      "const": "float64"
    },
    "element": {
      "description": "A 64-bit IEEE 754 floating point number.",
      "oneOf": [
        {
          "type": "number",
          "description": "Rounded to the nearest representable value using round half to even."
        },
        {
          "type": "string",
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ]
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{16}$",
          "description": "The bit pattern of the value as 16 hexadecimal digits."
        }
      ]
    }
  }
}
