{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uint64",
  "description": "Unsigned 64-bit integer data type.",
  "type": "object",
  "properties": {
    "data_type": {
      "$ref": "#/$defs/identifier"
    },
    "fill_value": {
      "$ref": "#/$defs/element"
    }
  },
  "$defs": {
    "identifier": {
      "description": "The identifier of the uint64 data type.",
      "const": "uint64"
    },
    "element": {
      "description": "An integer in [0, 18446744073709551615].",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  }
}
