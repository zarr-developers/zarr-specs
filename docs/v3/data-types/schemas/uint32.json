{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uint32",
  "description": "Unsigned 32-bit integer data type.",
  "type": "object",
  "properties": {
    "data_type": {
      "$ref": "#/$defs/identifier"
    },
    "fill_value": {
      "$ref": "#/$defs/element"
    }
  },
  "$defs": {
    "identifier": {
      "description": "The identifier of the uint32 data type.",
      "const": "uint32"
    },
    "element": {
      "description": "An integer in [0, 4294967295].",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  }
}
