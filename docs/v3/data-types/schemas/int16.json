{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "int16",
  "description": "Signed 16-bit integer data type.",
  "type": "object",
  "properties": {
    "data_type": {
      "$ref": "#/$defs/identifier"
    },
    "fill_value": {
      "$ref": "#/$defs/element"
    }
  },
  "$defs": {
    "identifier": {
      "description": "The identifier of the int16 data type.",
      "const": "int16"
    },
    "element": {
      "description": "An integer in [-32768, 32767].",
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    }
  }
}
