{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "int32",
  "description": "Signed 32-bit integer data type.",
  "type": "object",
  "properties": {
    "data_type": {
      "$ref": "#/$defs/identifier"
    },
    "fill_value": {
      "$ref": "#/$defs/element"
    }
  },
  "$defs": {
    "identifier": {
      "description": "The identifier of the int32 data type.",
      "const": "int32"
    },
    "element": {
      "description": "An integer in [-2147483648, 2147483647].",
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    }
  }
}
